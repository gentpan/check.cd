# Server-only. Never prefix secrets with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Set a random token of at least 32 characters to enable /admin.
ADMIN_TOKEN=
NEWS_AUTO_UPDATE=false
NEWS_DATA_PATH=data/news.json
# Optional documented IP intelligence. Without a token, known visitor IPs remain
# available but provider-only fields stay unknown. Never expose this in VITE_*.
IPINFO_TOKEN=
# lite: country + ASN only. core/plus/max use /lookup with your existing plan.
# Choosing a tier does not buy/upgrade a plan. Missing fields remain unknown.
# IPinfo supplies no purity score, six-dimension score, or AI eligibility verdict.
IPINFO_TIER=lite
# Empty means trust only the actual connection address. Set x-real-ip only when
# your sole ingress proxy overwrites it and direct access to the app is blocked.
# Both deploy/checkcd.caddy and deploy/nginx.conf use TRUST_PROXY_HEADER=x-real-ip.
# With a CDN, configure that proxy's trusted CDN CIDRs first; never trust all IPs.
# Other supported values: cf-connecting-ip, x-forwarded-for (single address only).
# Unset in local development: loopback is not a visitor's public IP, so unknown
# is expected. Do not enable proxy trust merely to hide that unknown result.
TRUST_PROXY_HEADER=
