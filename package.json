{
  "name": "check-cc",
  "version": "0.1.0",
  "description": "Claude environment checker and account-risk analysis tool.",
  "license": "MIT",
  "homepage": "https://check.cd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentpan/check.cd.git"
  },
  "bugs": {
    "url": "https://github.com/gentpan/check.cd/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "keywords": [
    "claude",
    "anthropic",
    "environment-checker",
    "risk-analysis",
    "tanstack-start"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  }
}
